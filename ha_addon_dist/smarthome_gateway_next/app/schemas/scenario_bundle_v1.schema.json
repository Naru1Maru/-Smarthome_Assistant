{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioBundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "rules",
    "clarification"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "rules": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "clarification": {
      "$ref": "#/$defs/clarification"
    }
  },
  "$defs": {
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needed",
        "question",
        "missing_fields"
      ],
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "question": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "missing_fields": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "area_name",
        "entity_ids"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "UNSPECIFIED",
            "AREA",
            "ENTITY",
            "ALL_LIGHTS"
          ]
        },
        "area_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "entity_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "color": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name",
        "rgb"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "rgb": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "action_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brightness",
        "brightness_delta",
        "color",
        "color_temp_kelvin",
        "color_temp_delta_k",
        "transition_s"
      ],
      "properties": {
        "brightness": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "brightness_delta": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -100,
          "maximum": 100
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "color_temp_kelvin": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1500,
          "maximum": 6500
        },
        "color_temp_delta_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -3000,
          "maximum": 3000
        },
        "transition_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "intent",
        "target",
        "params"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "light",
            "switch"
          ]
        },
        "intent": {
          "type": "string",
          "enum": [
            "TURN_ON",
            "TURN_OFF",
            "SET_BRIGHTNESS",
            "ADJUST_BRIGHTNESS",
            "SET_COLOR",
            "SET_COLOR_TEMP",
            "ADJUST_COLOR_TEMP"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "params": {
          "$ref": "#/$defs/action_params"
        }
      }
    },
    "time_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at"
      ],
      "properties": {
        "type": {
          "const": "time"
        },
        "at": {
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
        },
        "days_of_week": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 7,
          "items": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          }
        }
      }
    },
    "state_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "entity_id",
        "to"
      ],
      "properties": {
        "type": {
          "const": "state"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "for_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "numeric_state_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "entity_id",
        "above",
        "below"
      ],
      "properties": {
        "type": {
          "const": "numeric_state"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "above": {
          "type": [
            "number",
            "null"
          ]
        },
        "below": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "above": {
              "type": "number"
            }
          }
        },
        {
          "properties": {
            "below": {
              "type": "number"
            }
          }
        }
      ]
    },
    "trigger": {
      "oneOf": [
        {
          "$ref": "#/$defs/time_trigger"
        },
        {
          "$ref": "#/$defs/state_trigger"
        },
        {
          "$ref": "#/$defs/numeric_state_trigger"
        }
      ]
    },
    "time_window_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "after",
        "before"
      ],
      "properties": {
        "type": {
          "const": "time_window"
        },
        "after": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
        },
        "before": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
        }
      },
      "anyOf": [
        {
          "properties": {
            "after": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "before": {
              "type": "string"
            }
          }
        }
      ]
    },
    "state_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "entity_id",
        "operator",
        "value"
      ],
      "properties": {
        "type": {
          "const": "state"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "operator": {
          "type": "string",
          "enum": [
            "==",
            "!="
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "for_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "numeric_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "entity_id",
        "operator",
        "value"
      ],
      "properties": {
        "type": {
          "const": "numeric"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "operator": {
          "type": "string",
          "enum": [
            "<",
            "<=",
            ">",
            ">=",
            "="
          ]
        },
        "value": {
          "type": "number"
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/time_window_condition"
        },
        {
          "$ref": "#/$defs/state_condition"
        },
        {
          "$ref": "#/$defs/numeric_condition"
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "enabled",
        "trigger",
        "conditions",
        "actions",
        "else_actions"
      ],
      "properties": {
        "rule_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "enabled": {
          "type": "boolean"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "conditions": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "else_actions": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    }
  }
}
